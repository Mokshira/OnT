# Python 缓存与构建产物
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
.venv/
venv/
env/

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 打包产物
build/
dist/
*.spec

# 本地运行配置（可能包含 API Key）
config.json
# ConfigManager 生成的损坏备份 config.json.corrupt-<时间戳>.bak 与原子写
# 临时文件 .config.json.tmp 都是原文件的字节级副本，同样含明文 API Key，
# 必须一并忽略，否则 `git add .` 会把密钥提交进仓库。
config.json.*
.config.json.tmp
# 历史遗留文件名（LEGACY_CONFIG_FILE_NAME）
config.son
config.son.*

# IDE 与系统文件
.vscode/
.workbuddy/
.codex/
.idea/
.tests/
*.swp
.DS_Store
Thumbs.db

gitignore
.gitignore
